# ReportCollector Frontend — шаблон конфигурации.
# Скопируйте в .env.local и заполните значения.

# --- Подключение к бэкенду (обязательно) ---
# Адрес API для server-side запросов (прокси, /api/me, локальный вход).
BACKEND_INTERNAL_URL=http://127.0.0.1:3000

# --- Сессия (обязательно) ---
# Публичный адрес приложения, куда браузер попадает после логина.
# Из него образуется redirect_uri Keycloak:
# <AUTH_APP_ORIGIN>/api/auth/callback — этот адрес должен быть
# в списке Valid redirect URIs клиента в Keycloak.
AUTH_APP_ORIGIN=http://127.0.0.1:5000
# HMAC-секрет подписи сессии и заголовков идентичности.
# Должен совпадать с AUTH_SECRET бэкенда. Минимум 32 символа.
AUTH_SECRET=

# --- Режим входа ---
# true (по умолчанию) — вход через Keycloak (нужен блок ниже);
# false — локальный вход по email + пароль (блок Keycloak не нужен).
KEYCLOAK_ENABLED=true

# --- Keycloak (только при KEYCLOAK_ENABLED=true; все переменные обязательны) ---
# Публичный issuer — для редиректов браузера на страницу авторизации.
AUTH_KEYCLOAK_PUBLIC_ISSUER=
# Внутренний issuer — для token/jwks/userinfo запросов из Node.js.
# По умолчанию равен публичному; задавайте отдельно только если Node.js
# ходит в Keycloak по другому адресу.
# AUTH_KEYCLOAK_INTERNAL_ISSUER=
# Клиент OIDC, зарегистрированный в Keycloak.
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_CLIENT_SECRET=

# Опциональные уточнения (есть дефолты в коде):
# AUTH_KEYCLOAK_SCOPES=openid profile email
# AUTH_KEYCLOAK_SIGNING_ALGORITHMS=RS256
# AUTH_KEYCLOAK_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
