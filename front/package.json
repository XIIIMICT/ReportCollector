        "jose": "^6.2.18",
        "next": "16.4.6",
        "next-themes": "^0.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "undici": "8.13.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
