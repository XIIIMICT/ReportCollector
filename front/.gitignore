# Денай-всё по умолчанию (см. корневой .gitignore): белый список ниже.
# .next/, node_modules/, тестовые артефакты Playwright, локальные .env
# и probe-скрипты автоматически вне индекса.
*

# Конфигурация и инструменты
!/.dockerignore
!/.gitignore
!/AGENTS.md
!Dockerfile
!bun.lock
!bunfig.toml
!next.config.ts
!oxfmt.config.ts
!oxlint.config.ts
!package.json
!playwright.config.ts
!postcss.config.ts
!prek.toml
!stylelint.config.mjs
!tsconfig.json

# Исходники, e2e и статика
!/e2e/
!/e2e/**
!/public/
!/public/**
!/src/
!/src/**
!/scripts/
!/scripts/**

# Мусор внутри белого списка (стоит после правил выше — последнее совпадение побеждает)
.heroui-docs/
*.tsbuildinfo
e2e/probe/
e2e/*-probe*
