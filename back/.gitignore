# Денай-всё по умолчанию (см. корневой .gitignore): белый список ниже.
*

# Конфигурация и инструменты
!/.dockerignore
!/.gitignore
!Dockerfile
!prek.toml
!pyproject.toml
!uv.lock

# Исходники и тесты
!/src/
!/src/**
!/tests/
!/tests/**

# Мусор внутри белого списка (стоит после правил выше — последнее совпадение побеждает)
__pycache__/
*.py[cod]
