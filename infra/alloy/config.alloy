local.file_match "reportcollector_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/reportcollector/*.log",
      "app"      = "reportcollector",
      "env"      = "local",
      "job"      = "reportcollector",
    },
  ]

  sync_period = "5s"
}

loki.source.file "reportcollector_logs" {
  targets       = local.file_match.reportcollector_logs.targets
  forward_to    = [loki.process.reportcollector.receiver]
  tail_from_end = false
}

loki.process "reportcollector" {
  stage.json {
    expressions = {
      "level"           = "level",
      "logger"          = "logger",
      "module"          = "module",
      "time"            = "timestamp",
      "event"           = "event",
      "duration_ms"     = "duration_ms",
      "form_id"         = "form_id",
      "form_db_name"    = "form_db_name",
      "status_code"     = "status_code",
      "user_email"      = "user_email",
      "rows_affected"   = "rows_affected",
      "method"          = "method",
      "path"            = "path",
      // Correlation: every log line of one request carries the same id, and the
      // same id is returned to the client in `X-Request-ID`. Without it here a
      // reported error cannot be traced to its exception and its call sequence —
      // the field exists in the JSON but died at ingest.
      "request_id"      = "request_id",
      "error_type"      = "error_type",
      "error"           = "error",
      "exception"       = "exception",
    }
  }

  stage.labels {
    values = {
      "level"        = "",
      "logger"       = "",
      "module"       = "",
      "event"        = "",
      "form_db_name" = "",
    }
  }

  stage.structured_metadata {
    values = {
      "form_id"       = "form_id",
      "user_email"    = "user_email",
      "duration_ms"   = "duration_ms",
      "status_code"   = "status_code",
      "rows_affected" = "rows_affected",
      "method"        = "method",
      "path"          = "path",
      // Same reasoning as above: queryable but NOT a label — a uuid per request
      // as a label would explode the index, which is why it is metadata.
      "request_id"    = "request_id",
      "error_type"    = "error_type",
      "error"         = "error",
      "exception"     = "exception",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
}
