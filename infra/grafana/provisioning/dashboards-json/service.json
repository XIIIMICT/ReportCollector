{
  "uid": "rc-service",
  "title": "ReportCollector · Сервис",
  "description": "Latency percentiles and error rate of the backend. Answers «система деградирует?» — the first question during any incident.",
  "tags": ["reportcollector"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Маршрут",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
        "query": "label_values(http_requests_total, route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Запросов в секунду",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{route=~\"$route\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Доля 5xx",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{route=~\"$route\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{route=~\"$route\"}[5m])), 0.000001)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 (все маршруты)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Запросов в обработке",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [{ "expr": "http_requests_in_progress", "legendFormat": "in flight", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Латентность по перцентилям (все маршруты)",
      "description": "Перцентили считаются только из гистограммы — из логов их получить нельзя.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Запросы по статус-кодам",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{route=~\"$route\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Самые медленные маршруты (p95)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Скребок жив",
      "description": "up = 0 значит Prometheus не может достучаться до бэкенда: контейнер упал, порт не проброшен или нет /metrics.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [{ "expr": "up{job=\"reportcollector-back\"}", "legendFormat": "{{job}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Пул PostgreSQL",
      "description": "Занятые соединения, overflow и предел пула. Рост к пределу означает ожидание до таймаута.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "db_connections_in_use", "legendFormat": "занято", "refId": "A" },
        { "expr": "db_pool_overflow", "legendFormat": "overflow", "refId": "B" },
        { "expr": "db_pool_capacity", "legendFormat": "ёмкость", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Очередь Excel-выгрузок",
      "description": "Очередь и активные задания разделены по типу экспорта.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "export_jobs_queue_depth", "legendFormat": "ожидают {{kind}}", "refId": "A" },
        { "expr": "export_jobs_active", "legendFormat": "активны {{kind}}", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(export_job_queue_wait_seconds_bucket[10m])))", "legendFormat": "p95 ожидания {{kind}}", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "C" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Фазы импорта и экспорта",
      "description": "p95 по фазам показывает, где тратится время большой операции.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "topk(12, histogram_quantile(0.95, sum by (le, operation, phase) (rate(data_operation_duration_seconds_bucket[10m]))))", "legendFormat": "p95 {{operation}} / {{phase}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Память, event loop и диск",
      "description": "ProcessCollector даёт RSS/CPU; приложение дополнительно измеряет задержку event loop и свободное место.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(runtime_event_loop_lag_seconds_bucket[10m]))", "legendFormat": "p95 event loop", "refId": "B" },
        { "expr": "runtime_disk_free_bytes", "legendFormat": "свободно {{storage}}", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "PostgreSQL: ожидание и запросы",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_acquire_seconds_bucket[10m])))", "legendFormat": "p95 получение соединения", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(db_query_duration_seconds_bucket[10m])))", "legendFormat": "p95 SQL", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(data_operation_duration_seconds_bucket{operation=\"database_lock\"}[10m])))", "legendFormat": "p95 блокировки {{phase}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Valkey и зависимости",
      "description": "Время операций включает повторы клиента; ожидание сообщений в тихой комнате исключено. Ошибки показаны на правой оси.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(valkey_operation_duration_seconds_bucket[10m])))", "legendFormat": "p95 {{operation}}", "refId": "A" },
        { "expr": "sum by (outcome) (rate(valkey_operation_duration_seconds_count{outcome=~\"error|connection_error|timeout\"}[5m]))", "legendFormat": "ошибки/с {{outcome}}", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(dependency_check_duration_seconds_bucket[10m])))", "legendFormat": "readiness {{dependency}}", "refId": "C" },
        { "expr": "rate(valkey_subscription_failures_total[5m])", "legendFormat": "сбои pub/sub /с", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "unit", "value": "ops" }, { "id": "custom.axisPlacement", "value": "right" }] },
          { "matcher": { "id": "byFrameRefID", "options": "D" }, "properties": [{ "id": "unit", "value": "ops" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Auth rate limiting",
      "description": "Shared Valkey decisions and local degraded fallback for authentication endpoints.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "sum by (storage, outcome) (rate(auth_rate_limit_events_total[5m]))", "legendFormat": "{{storage}} / {{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "PostgreSQL: бекапы",
      "description": "Возраст последнего успешного бекапа (RPO ≤ 24 ч), размер дампа и число файлов в retain. Метрики пишет sidecar pgbackup.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "pg_backup_last_success_age_seconds{job=\"reportcollector-pg-backup\"}", "legendFormat": "возраст бекапа", "refId": "A" },
        { "expr": "pg_backup_last_size_bytes{job=\"reportcollector-pg-backup\"}", "legendFormat": "размер дампа", "refId": "B" },
        { "expr": "pg_backup_files_retained{job=\"reportcollector-pg-backup\"}", "legendFormat": "файлов в retain", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "unit", "value": "bytes" }, { "id": "custom.axisPlacement", "value": "right" }] },
          { "matcher": { "id": "byFrameRefID", "options": "C" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Возраст репетиции восстановления",
      "description": "Еженедельный drill: age выше 7 дней — предупреждение, выше 8 — алерт PgRestoreDrillOverdue.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "reportcollector-prometheus" },
      "targets": [
        { "expr": "pg_backup_drill_last_success_age_seconds{job=\"reportcollector-pg-backup\"}", "legendFormat": "drill age", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 604800 },
              { "color": "red", "value": 691200 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value" }
    }
  ]
}
