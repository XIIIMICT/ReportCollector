# Денай-всё по умолчанию: в индекс попадает только то, что явно перечислено ниже.
# Временные файлы (probe-скрипты *.mjs/*.cjs, логи, артефакты сборки, .env
# и прочий мусор) автоматически остаются вне репозитория — их не нужно
# вручную добавлять в игнор.
*

# Корневые файлы
!/prek.toml
!/.env.example
!/.gitattributes
!/.gitignore
!/.mcp.json
!/.gitleaks.toml
!/opencode.json
!/compose.yaml
!/justfile
!/AGENTS.md
!/scripts/
!/scripts/**

# Каталоги: возвращаем в индекс сам каталог, чтобы git мог в него зайти.
# Содержимое back/ и front/ белыми списками задают их собственные .gitignore.
!/.github/
!/.github/**
!/docs/
!/docs/**
!/load/
!/load/**
!/infra/
!/infra/**
# Bytecode from the stdlib-only infra bind guard/tests is never source.
__pycache__/
*.py[cod]
# `logs/` is a RUNTIME directory: the app, the tests and the containers write
# here. Only the placeholder is tracked, so the folder exists in a fresh
# checkout — the logs themselves are never committed.
#
# Three lines are needed, in this order, and `/logs/**` must NOT be used here:
# `**` matches the placeholder itself, so `!/logs/.gitkeep` can no longer win and
# the folder stops existing in a clone. Verified with `git check-ignore` in a
# scratch repo (deny-all `*` + these rules):
#   !/logs/          — git will not descend into an IGNORED directory, so the
#                      folder is re-included first (the deny-all `*` at the top
#                      would otherwise make everything below unreachable);
#   /logs/*          — drops the directory's CONTENTS, files and subdirectories;
#   !/logs/.gitkeep  — brings the placeholder back.
!/logs/
/logs/*
!/logs/.gitkeep
!/back/
!/front/

# Seed reference sources (docs/seed/): the renovation workbook (~94k rows,
# 129 MB), raw-materials plan workbooks («Планы», ~72 MB) and the source
# specs are local-only artifacts, never committed; seeds fall back to demo
# rows when the files are absent.
/docs/seed/
