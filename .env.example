# ReportCollector — шаблон конфигурации.
# Скопируйте в .env и заполните значения.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Обязательные. POSTGRES_HOST переопределяется compose на имя сервиса (postgres)
# внутри Docker-стека; localhost — для запуска приложения на хосте.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Схема, в которой живут все таблицы проекта «Сырьё» (например, rc).
POSTGRES_SCHEMA=

# ─── Подпись идентичности ───────────────────────────────────────────────────
# HMAC-секрет, общий для front и back. Минимум 32 символа.
AUTH_SECRET=

# ─── Сидирование администратора (опционально) ───────────────────────────────
# Задаются только парой: email + имя.
# AUTH_SEED_ADMIN_EMAIL=
# AUTH_SEED_ADMIN_NAME=

# ─── CORS (обязательно) ─────────────────────────────────────────────────────
# Ориджины фронтенда. JSON-массив или список через запятую.
BACKEND_CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000"]

# ─── Фронтенд (обязательно для docker-стека) ────────────────────────────────
# Публичный адрес приложения; из него образуется redirect_uri Keycloak.
AUTH_APP_ORIGIN=http://127.0.0.1:5000
AUTH_COOKIE_SECURE=false

# ─── Режим входа ─────────────────────────────────────────────────────────────
# true — вход через Keycloak (в compose поднимается rc-keycloak);
# false — локальный вход по email + пароль (e2e-тесты используют его).
KEYCLOAK_ENABLED=true

# ─── Ключевой / корпоративный Keycloak ───────────────────────────────────────
# Публичный issuer — для редиректов браузера на страницу авторизации.
AUTH_KEYCLOAK_PUBLIC_ISSUER=http://127.0.0.1:8180/realms/reportcollector
# Внутренний issuer для запросов из Node.js при запуске на хосте.
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8180/realms/reportcollector
# Внутренний issuer из контейнера (имя сервиса keycloak в compose).
AUTH_KEYCLOAK_DOCKER_INTERNAL_ISSUER=http://keycloak:8080/realms/reportcollector
# Точное значение claim iss в ID token, если отличается от issuer (корпоративный случай).
# AUTH_KEYCLOAK_TOKEN_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=ReportCollector
AUTH_KEYCLOAK_CLIENT_SECRET=
AUTH_KEYCLOAK_SCOPES=openid profile email
AUTH_KEYCLOAK_SIGNING_ALGORITHMS=RS256
AUTH_KEYCLOAK_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic

# ─── Локальный Keycloak (контейнер rc-keycloak) ─────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_HOSTNAME=http://127.0.0.1:8180