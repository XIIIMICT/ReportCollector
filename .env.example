# ReportCollector — единственный шаблон конфигурации.
# • Docker-стек и justfile читают корневой .env: cp .env.example .env.
# • Запуск фронта на хосте (just front): cp .env.example front/.env.local
#   — Next.js сам загружает front/.env.local, лишние переменные (Postgres,
#   Loki и т.п.) ему не мешают.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Обязательные. POSTGRES_HOST=localhost — для запуска приложения на хосте;
# внутри Docker-стека переопределите его (host.docker.internal — если Postgres
# внешний, или имя сервиса, когда Postgres поднят в compose-сети).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_DOCKER_HOST=host.docker.internal
POSTGRES_PORT=5432
# Схема, в которой живут все таблицы проекта «Сырьё» (например, rc).
POSTGRES_SCHEMA=
# Bounded asyncpg pool. Keep the total across all backend workers/replicas below
# PostgreSQL max_connections; timeouts fail fast instead of pinning requests.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=30000
# Import request body guard: max XLSB bytes plus multipart overhead and upload
# receive timeout. Parsing/apply time starts only after the body is complete.
RENOVATION_IMPORT_MAX_BYTES=268435456
RENOVATION_UPLOAD_TIMEOUT_SECONDS=300

# ─── Valkey/Redis (совместное редактирование) ────────────────────────────────
# Адрес сервера блокировок ячеек, присутствия и pub/sub. Пустое значение —
# in-memory режим (без межворкерной синхронизации). Внутри Docker-стека
# используйте host.docker.internal:6379 или имя сервиса valkey.
VALKEY_URL=redis://127.0.0.1:6379/0

# ─── Подпись идентичности ───────────────────────────────────────────────────
# HMAC-секрет, общий для front и back. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=

# ─── Сидирование администратора (опционально) ───────────────────────────────
# Задаются только парой: email + пароль. Пароль задаёт сидируемому админу
# хэш для локального входа; email активирует админа при первом входе через Keycloak.
# AUTH_SEED_ADMIN_EMAIL=
# AUTH_SEED_ADMIN_PASSWORD=

# ─── Порт и хост бэкенда/фронтенда (обязательные, одна точка, откуда
#     расходятся в Dockerfile, проброс портов, healthcheck и внутренние URL) ─
BACKEND_PORT=8000
FRONT_PORT=5000
# Имя сервиса бэкенда в compose-сети (если переименовали сервис — поменять здесь).
BACKEND_HOST=back
BACKEND_HOST_DEV=back-dev

# ─── CORS ─────────────────────────────────────────────────────────────────────
# В compose-стеке BACKEND_CORS_ORIGINS выводится автоматически из
# AUTH_APP_ORIGIN (ниже): локальные dev-адреса + хост приложения — отдельно
# задавать не нужно. Бэкенд без переменной по умолчанию разрешает только
# localhost-ориджины; явное значение задавайте, только если запускаете бэкенд
# на хосте (вне compose) под другим адресом.
# BACKEND_CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000","https://m2v-form-1.h2-group.ru"]

# ─── Фронтенд ────────────────────────────────────────────────────────────────
# Единый источник хоста приложения: из него образуются redirect_uri Keycloak,
# Secure-cookie и список CORS-ориджинов (см. выше). Продакшен:
# AUTH_APP_ORIGIN=https://m2v-form-1.h2-group.ru
AUTH_APP_ORIGIN=http://127.0.0.1:5000
# Адрес бэкенда для server-side запросов фронта (прокси /api/*, /api/me).
# В docker-стеке выводится из BACKEND_HOST/BACKEND_PORT (см. compose.yaml) —
# задавать не нужно. Обязателен только при запуске фронта на хосте
# (front/.env.local): http://127.0.0.1:8000
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_URL — алиас AUTH_APP_ORIGIN, в compose выводится автоматически;
# вручную не задавать (иначе разъедется с CORS/redirect_uri).
# Долгота сессии (секунды). По умолчанию 12 часов; не зависит от короткого
# TTL ID token Keycloak (иначе пользователя выкидывает как «не авторизован»).
# AUTH_SESSION_MAX_AGE_SECONDS=43200
# Адрес WebSocket совместного редактирования, который подставляется в браузер.
# Пустое значение = браузер идёт на тот же origin, где открыта страница
# (ws:// или wss:// автоматически по протоколу страницы) — правильный вариант,
# когда TLS и /api/ws/ раздаёт nginx. Задавать адрес нужно только если WS
# обслуживается отдельным хостом/портом (например, dev-режим без nginx:
# COLLAB_WS_PUBLIC_URL=ws://127.0.0.1:8000).
# COLLAB_WS_PUBLIC_URL=

# ─────────────── Поддержка: «Связаться с разработчиком» ───────────────
# Адрес почты, на который уходит письмо из кнопки в шапке (иконка наушников
# с микрофоном, рядом с профилем). Тема письма — «Обращение по РепортКоллектор
# <Ремонт / КППК / Сырьё>», поэтому один ящик принимает обращения по всем
# проектам. Значение читается только на сервере и передаётся в интерфейс
# пропсом (не NEXT_PUBLIC_): адрес не попадает в клиентский бандл.
# Пусто — кнопка не показывается.
# SUPPORT_MAIL=support@example.ru

# ─── Алерты Alertmanager → почта ────────────────────────────────────────────
# Доставка писем требует SMTP-релея, доступного из сети приложения (порты
# 25/465/587). Без него правила срабатывают и видны в http://localhost:9093,
# но письма не уходят — см. docs/SCALING_BACKLOG.md §2.
# ALERT_SMTP_SMARTHOST=smtp.example.com:465
# ALERT_SMTP_FROM=support@example.ru
# ALERT_SMTP_USER=support@example.ru
# ALERT_SMTP_PASSWORD=change_me

# ─── Режим входа ─────────────────────────────────────────────────────────────
# true — вход через Keycloak (корпоративный или локальный из профиля standalone);
# false — локальный вход по email + пароль (e2e-тесты используют его).
KEYCLOAK_ENABLED=true

# ─── Ключевой / корпоративный Keycloak ───────────────────────────────────────
# Публичный issuer — для редиректов браузера на страницу авторизации.
AUTH_KEYCLOAK_PUBLIC_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer для запросов из Node.js при запуске на хосте.
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer из контейнера (имя сервиса keycloak в compose).
AUTH_KEYCLOAK_DOCKER_INTERNAL_ISSUER=http://keycloak:8080/realms/reportcollector
# Точное значение claim iss в ID token, если отличается от issuer (корпоративный случай).
# AUTH_KEYCLOAK_TOKEN_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=ReportCollector
AUTH_KEYCLOAK_CLIENT_SECRET=

# ─── Локальный Keycloak (контейнер rc-keycloak, профиль standalone) ─────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=http://127.0.0.1:8080

# ─── Логирование (обязательно для compose) ───────────────────────────────────
# Адрес общего Loki, доступный из контейнера Alloy.
LOKI_URL=http://loki:3100

# ─── Локальная Grafana (контейнер rc-grafana, профиль standalone) ────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=strong_password

# ─── Docker-сборка ──────────────────────────────────────────────────────────────
# Corporate-proxy workaround: uv allows insecure pypi.org/files.pythonhosted.org;
# Bun build/dev stages use NODE_TLS_REJECT_UNAUTHORIZED=0. The Node production
# runtime does not inherit this exception. Prefer a trusted corporate CA when available.
