# ReportCollector — шаблон конфигурации.
# Скопируйте в .env и заполните значения.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Обязательные. POSTGRES_HOST=localhost — для запуска приложения на хосте;
# внутри Docker-стека переопределите его (host.docker.internal — если Postgres
# внешний, или имя сервиса, когда Postgres поднят в compose-сети).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Схема, в которой живут все таблицы проекта «Сырьё» (например, rc).
POSTGRES_SCHEMA=

# ─── Valkey/Redis (совместное редактирование) ────────────────────────────────
# Адрес сервера блокировок ячеек, присутствия и pub/sub. Пустое значение —
# in-memory режим (без межворкерной синхронизации). Внутри Docker-стека
# используйте host.docker.internal:6379 или имя сервиса valkey.
VALKEY_URL=redis://127.0.0.1:6379/0

# ─── Подпись идентичности ───────────────────────────────────────────────────
# HMAC-секрет, общий для front и back. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=

# ─── Сидирование администратора (опционально) ───────────────────────────────
# Задаются только парой: email + пароль. Пароль задаёт сидируемому админу
# хэш для локального входа; email активирует админа при первом входе через Keycloak.
# AUTH_SEED_ADMIN_EMAIL=
# AUTH_SEED_ADMIN_PASSWORD=

# ─── CORS (обязательно) ─────────────────────────────────────────────────────
# Ориджины фронтенда. JSON-массив или список через запятую.
BACKEND_CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000"]

# ─── Фронтенд (обязательно для docker-стека) ────────────────────────────────
# Публичный адрес приложения; из него образуется redirect_uri Keycloak.
# Cookie сессии Secure ставится автоматически при https в этом адресе.
AUTH_APP_ORIGIN=http://127.0.0.1:5000

# ─── Режим входа ─────────────────────────────────────────────────────────────
# true — вход через Keycloak (корпоративный или локальный из профиля standalone);
# false — локальный вход по email + пароль (e2e-тесты используют его).
KEYCLOAK_ENABLED=true

# ─── Ключевой / корпоративный Keycloak ───────────────────────────────────────
# Публичный issuer — для редиректов браузера на страницу авторизации.
AUTH_KEYCLOAK_PUBLIC_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer для запросов из Node.js при запуске на хосте.
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer из контейнера (имя сервиса keycloak в compose).
AUTH_KEYCLOAK_DOCKER_INTERNAL_ISSUER=http://keycloak:8080/realms/reportcollector
# Точное значение claim iss в ID token, если отличается от issuer (корпоративный случай).
# AUTH_KEYCLOAK_TOKEN_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=ReportCollector
AUTH_KEYCLOAK_CLIENT_SECRET=

# ─── Локальный Keycloak (контейнер rc-keycloak, профиль standalone) ─────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=http://127.0.0.1:8080

# ─── Логирование (обязательно для compose) ───────────────────────────────────
# Адрес общего Loki, доступный из контейнера Alloy.
LOKI_URL=http://loki:3100

# ─── Локальная Grafana (контейнер rc-grafana, профиль standalone) ────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=strong_password

# ─── Docker-сборка (опционально) ─────────────────────────────────────────────
# Если не пуст — в Dockerfile применяются обходы проблем с TLS при установке
# зависимостей: установка ca-certificates, UV_SYSTEM_CERTS=1, NODE_OPTIONS=--use-openssl-ca.
# Пустое значение = TLS работает из коробки, обходы не применяются.
SSL_ISSUES_WHEN_INSTALLING_DEPS=
