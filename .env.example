# ReportCollector — единый шаблон конфигурации.
# • Docker-стек и justfile читают корневой .env: cp .env.example .env.
# • Запуск фронта на хосте: cp .env.example front/.env.local —
#   Next.js сам загружает front/.env.local, лишние переменные (Postgres,
#   Loki и т.п.) ему не мешают.

# ── PostgreSQL ────────────────────────────────
# Обязательные. POSTGRES_HOST=localhost для запуска приложения на хосте;
# внутри Docker-стека compose подставляет POSTGRES_HOST_DOCKER
# (host.docker.internal для внешнего Postgres или
# имя сервиса, когда Postgres поднят в compose-сети).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_HOST_DOCKER=host.docker.internal
POSTGRES_PORT=5432
# Схема, в которой живут все таблицы проекта «Сырьё» (например, rc).
POSTGRES_SCHEMA=
# Ограниченный пул asyncpg. Общая сумма по всем воркерам/репликам не должна
# превышать PostgreSQL max_connections; таймауты падают сразу, а не держат
# запрос в подвешенном состоянии.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=30000
# Ограничение загрузки: максимум байт XLSB с учётом multipart-накладных и
# таймаут приёма тела. Парсинг/применение начинается только после приёма
# всего тела.
RENOVATION_IMPORT_MAX_BYTES=268435456
RENOVATION_UPLOAD_TIMEOUT_SECONDS=300

# ── Valkey/Redis (совместное редактирование) ──
# Сервер блокировок ячеек, присутствия и pub/sub. Пустое значение — in-memory
# режим (без межворкерной синхронизации). Внутри Docker-стека используйте
# host.docker.internal:6379 или имя сервиса valkey.
VALKEY_URL=redis://127.0.0.1:6379/0

# ── Подпись идентичности ──────────────
# HMAC-секрет, общий для front и back, минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=

# ── Сидирование администратора (опционально) ──
# Задаются только парой: email + пароль. Пароль задаёт сидируемому админу
# хэш для локального входа; email активирует админа при первом входе через
# Keycloak.
# AUTH_SEED_ADMIN_EMAIL=
# AUTH_SEED_ADMIN_PASSWORD=

# ── Порты и хосты ───────────────────────
# Единая точка, откуда расходятся порт бэкенда/фронта (Dockerfile ARG,
# проброс портов, healthcheck, внутренние URL) и имя сервиса бэкенда в
# compose-сети. Обязательные.
BACKEND_PORT=8000
FRONT_PORT=5000
BACKEND_HOST=back
BACKEND_HOST_DEV=back-dev

# ── CORS ────────────────────────
# В compose-стеке BACKEND_CORS_ORIGINS выводится автоматически из
# AUTH_APP_ORIGIN (ниже): локальные dev-адреса + хост приложения — отдельно
# задавать не нужно. Бэкенд без переменной по умолчанию разрешает только
# localhost-ориджины; явное значение задавайте, только если запускаете бэкенд
# на хосте (вне compose) под другим адресом.
# BACKEND_CORS_ORIGINS=["http://localhost:5000","http://127.0.0.1:5000","https://m2v-form-1.h2-group.ru"]

# ── Фронтенд ──────────────────────────
# Единый источник хоста приложения: из него образуются redirect_uri Keycloak,
# Secure-cookie и список CORS-ориджинов. Продакшен:
# AUTH_APP_ORIGIN=https://m2v-form-1.h2-group.ru
AUTH_APP_ORIGIN=http://127.0.0.1:5000
# Адрес бэкенда для server-side запросов фронта (proxy /api/*, /api/me).
# В docker-стеке выводится из BACKEND_HOST/BACKEND_PORT — задавать не нужно.
# Обязателен только при запуске фронта на хосте (front/.env.local).
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_URL — алиас AUTH_APP_ORIGIN, в compose выводится автоматически;
# вручную не задавать (иначе разъедется с CORS/redirect_uri).
# Долгота сессии (секунды). По умолчанию 12 часов; не зависит от короткого
# TTL ID token Keycloak (иначе пользователя выкидывает как «не авторизован»).
# AUTH_SESSION_MAX_AGE_SECONDS=43200
# Адрес WebSocket совместного редактирования для браузера. Пусто = тот же
# origin, что и страница (ws/wss автоматически) — правильный вариант, когда
# TLS и /api/ws/ раздаёт nginx. Задавать нужно только при отдельном хосте WS
# (например, dev без nginx: COLLAB_WS_PUBLIC_URL=ws://127.0.0.1:8000).
# COLLAB_WS_PUBLIC_URL=

# ── Обратная связь: «Связаться с разработчиком» ──
# Почта письма из кнопки в шапке. Тема — «Обращение по РепортКоллектор
# <Ремонт / КППК / Сырьё>», один ящик принимает обращения по всем проектам.
# Значение читается только на сервере и не попадает в клиентский бандл.
# Пусто — кнопка не показывается.
# SUPPORT_MAIL=support@example.ru

# ── Вход (Keycloak) ─────────────────────
# Режим входа: true — вход через Keycloak (корпоративный или локальный
# контейнер rc-keycloak, `just auth-stand`); false — локальный вход по
# email + пароль (e2e-тесты используют его).
KEYCLOAK_ENABLED=true
# Публичный issuer — для редиректов браузера на страницу авторизации.
AUTH_KEYCLOAK_PUBLIC_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer для запросов из Node.js при запуске на хосте.
AUTH_KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/reportcollector
# Внутренний issuer из контейнера (имя сервиса keycloak в compose).
AUTH_KEYCLOAK_DOCKER_INTERNAL_ISSUER=http://keycloak:8080/realms/reportcollector
# Точное значение claim iss в ID token, если отличается от issuer (корпоративный случай).
# AUTH_KEYCLOAK_TOKEN_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=ReportCollector
AUTH_KEYCLOAK_CLIENT_SECRET=

# ── Локальный Keycloak (контейнер rc-keycloak, `just auth-stand`) ──
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=http://127.0.0.1:8080

# ── Логирование (обязательно для compose) ─
# Адрес Loki, доступный из контейнера Alloy (rc-alloy). В локальном стеке
# (`just monitoring-stand`) это имя сервиса этого же compose-проекта (loki);
# для внешнего/центрального Loki задайте host.docker.internal:3100 или полный
# адрес сервера.
LOKI_URL=http://loki:3100
# Лейбл env на всех логах (Alloy). local для локального стека; на сервере
# задайте prod, чтобы прод-логи отличались от локальных.
LOG_ENV=local

# ── Локальная Grafana (контейнер rc-grafana, `just monitoring-stand`) ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=strong_password

# ── Алерты Alertmanager → почта ─────────
# Доставка писем требует SMTP-релея, доступного из сети приложения
# (порты 25/465/587). Без него правила срабатывают и видны на
# http://localhost:9093, но письма не уходят — см. docs/ARCHITECTURE.md и
# docs/TODO.md. STARTTLS-подача обычно на порту 587 (465 — неявный TLS,
# с smtp_require_tls Alertmanager несовместим). Значения рендерятся при
# старте контейнера — после правки перезапустите стек (`just monitoring-stand`).
# ALERT_SMTP_SMARTHOST=smtp.example.com:587
# ALERT_SMTP_FROM=support@example.ru
# ALERT_SMTP_USER=support@example.ru
# ALERT_SMTP_PASSWORD=change_me

# ── nginx (контейнер rc-nginx, `just proxy-stand`) ──
# Та же сборка fholzer/nginx-brotli, что и в центральном infra-стеке DWH;
# на проде обратный прокси живёт там, эта секция — для локального запуска.
# NGINX_SERVER_NAME — SNI/Host; пустые TLS-пути включают временный
# self-signed сертификат только для локальной проверки. Апстримы по умолчанию
# — сервисы этого compose-проекта (front + FRONT_PORT, back + BACKEND_PORT);
# для dev-запуска задайте front-dev/back-dev, для внешнего —
# host.docker.internal.
# NGINX_SERVER_NAME=localhost
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# NGINX_TLS_CERT_PATH=
# NGINX_TLS_KEY_PATH=
# NGINX_UPSTREAM_HOST=
# NGINX_UPSTREAM_PORT=
# NGINX_BACKEND_HOST=
# NGINX_BACKEND_PORT=

# ── Права на bind-папки (Linux) ────────────────
# Bind-монтируемые папки (./logs) на хосте принадлежат пользователю, от
# которого снят деплой. Контейнеры-писатели (rc-back, rc-front) запускаются
# с его UID/GID, чтобы лог-файлы не создавались root'ом (иначе при перезаписи
# без sudo появляется «Permission denied»). Заполните своим id -u / id -g:
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
# В Docker Desktop значения игнорируются; 1000/1000 — безопасный дефолт.
# HOST_UID=1000
# HOST_GID=1000

# ── Docker-сборка ──────────
# Corporate-proxy workaround: uv allows insecure pypi.org/files.pythonhosted.org;
# Bun build/dev stages use NODE_TLS_REJECT_UNAUTHORIZED=0. The Node production
# runtime does not inherit this exception. Prefer a trusted corporate CA when available.
